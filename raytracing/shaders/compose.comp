// The last pass: the filtered irradiance times the albedo, tone mapped for the display.
#version 460
#define COMPUTE_PASS
#include "common.glsl"

layout(local_size_x = 8, local_size_y = 8) in;

layout(push_constant) uniform Pass {
    int step;
    int source; // 0: the accumulation, 1: filterA, 2: filterB, 3: the result of ray reconstruction, colour complete
    int target;
} pass;

void main() {
    const ivec2 size = imageSize(output_image);
    const ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(p, size)))
        return;
    vec3 color;
    if (pass.source == 3) {
        color = imageLoad(reconstructed, p).rgb;
    } else {
        const vec4 irradiance = pass.source == 0   ? imageLoad(accumulation, p)
                                : pass.source == 1 ? imageLoad(filterA, p)
                                                   : imageLoad(filterB, p);
        const vec4 albedo = imageLoad(albedoImage, p);
        color = irradiance.rgb * (albedo.a > 0.5 ? albedo.rgb : vec3(1.0));
    }
    color *= 0.9;
    color = (color * (2.51 * color + 0.03)) / (color * (2.43 * color + 0.59) + 0.14); // ACES fit
    color = pow(clamp(color, 0.0, 1.0), vec3(1.0 / 2.2));
    if ((camera.flags & 1u) != 0u)
        color = color.bgr;
    imageStore(output_image, p, vec4(color, 1.0));
}
